// GibiGib — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(MEMBER)
  birthDate    DateTime
  address      String
  oib          String   @unique
  monthlyTrainingGoal Int?
  avatarUrl    String?

  memberships Membership[]
  attendances Attendance[]
  entryTokens EntryToken[]
  news        News[]
  trainingTags TrainingTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  entryEvents         EntryEvent[]
}

model MembershipProgram {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  description  String?
  durationDays Int
  priceCents   Int
  isActive     Boolean @default(true)

  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id        String           @id @default(cuid())
  userId    String
  programId String
  startDate DateTime
  endDate   DateTime
  status    MembershipStatus @default(ACTIVE)

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  program MembershipProgram @relation(fields: [programId], references: [id])
  pauses  MembershipPause[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model MembershipPause {
  id           String    @id @default(cuid())
  membershipId String
  startedAt    DateTime
  endsAt       DateTime
  endedAt      DateTime?

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([membershipId, startedAt])
}

model Gym {
  id           String  @id @default(cuid())
  name         String
  city         String
  address      String
  workingHours String?
  capacity     Int

  attendances  Attendance[]
  devices      Device[]
  doorCommands DoorCommand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Scanner or door controller at a gym. It authenticates with a key whose hash is stored here.
model Device {
  id        String    @id @default(cuid())
  name      String
  gymId     String
  keyHash   String    @unique
  revokedAt DateTime?

  gym                  Gym           @relation(fields: [gymId], references: [id])
  entryEvents          EntryEvent[]
  consumedDoorCommands DoorCommand[]

  createdAt DateTime @default(now())

  @@index([gymId])
}

// Door opening queued by a granted scan and picked up once by a door device of the same gym.
model DoorCommand {
  id                 String    @id @default(cuid())
  gymId              String
  expiresAt          DateTime
  consumedAt         DateTime?
  consumedByDeviceId String?

  gym        Gym     @relation(fields: [gymId], references: [id])
  consumedBy Device? @relation(fields: [consumedByDeviceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([gymId, consumedAt, expiresAt])
}

model EntryToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance  Attendance?
  entryEvents EntryEvent[]

  createdAt DateTime @default(now())

  @@index([userId])
}

enum EntryOutcome {
  GRANTED
  INVALID_TOKEN
  TOKEN_USED
  TOKEN_EXPIRED
  NO_MEMBERSHIP
  MEMBERSHIP_PAUSED
  ANTI_PASSBACK
}

// One row per scan attempt, granted or denied, so misuse leaves a trace.
model EntryEvent {
  id           String       @id @default(cuid())
  userId       String?
  entryTokenId String?
  deviceId     String?
  outcome      EntryOutcome
  createdAt    DateTime     @default(now())

  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryToken EntryToken? @relation(fields: [entryTokenId], references: [id], onDelete: SetNull)
  device     Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, outcome, createdAt])
  @@index([createdAt])
}

model Attendance {
  id           String   @id @default(cuid())
  userId       String
  gymId        String
  entryTokenId String?  @unique
  checkInAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym        Gym         @relation(fields: [gymId], references: [id])
  entryToken EntryToken? @relation(fields: [entryTokenId], references: [id])

  @@index([userId])
  @@index([gymId])
}

model TrainingTag {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date
  time   String?
  color  String
  label  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}



model News {
  id          String    @id @default(cuid())
  title       String
  content     String
  publishedAt DateTime?
  authorId    String

  author User @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  codeHash  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
