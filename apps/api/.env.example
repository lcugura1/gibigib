# GibiGib API
PORT=3000
HOST=0.0.0.0
# Set to true only behind a reverse proxy that sets X-Forwarded-For, so rate limits see client IPs
TRUST_PROXY=false

# PostgreSQL (Docker Compose)
POSTGRES_USER=gibigib
POSTGRES_PASSWORD=change_me
POSTGRES_DB=gibigib
POSTGRES_PORT=5432

# Prisma — connection string (host -> mapped Docker port)
DATABASE_URL="postgresql://gibigib:change_me@localhost:5432/gibigib?schema=public"

# Auth
# Required: generate with `openssl rand -base64 48`. The API refuses to start without it.
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Entry
# A member cannot enter again within this many minutes of their last entry (0 turns it off)
ENTRY_ANTI_PASSBACK_MINUTES=30

# Email (SMTP). Locally this is Mailpit from docker compose; read the inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GibiGib <no-reply@gibigib.local>"
