# GibiGib API
PORT=3000
HOST=0.0.0.0

# PostgreSQL (Docker Compose)
POSTGRES_USER=gibigib
POSTGRES_PASSWORD=change_me
POSTGRES_DB=gibigib
POSTGRES_PORT=5432

# Prisma — connection string (host -> mapped Docker port)
DATABASE_URL="postgresql://gibigib:change_me@localhost:5432/gibigib?schema=public"

# Auth
JWT_SECRET_KEY=replace-with-openssl-rand-base64-48
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
