# GibiGib bridge: connects a Hikvision access terminal to the API

# The API and a scanner device key (pnpm --filter @gibigib/api device create --kind scanner --name "...")
API_URL=http://localhost:3000
DEVICE_KEY=

# The Hikvision terminal (ISAPI). For the local simulator use http://localhost:8090 and the
# simulator's username and password below.
HIKVISION_URL=http://localhost:8090
HIKVISION_USERNAME=admin
HIKVISION_PASSWORD=simulator123
HIKVISION_DOOR=1

# Local Hikvision simulator (pnpm --filter @gibigib/bridge simulator)
SIMULATOR_PORT=8090
SIMULATOR_USERNAME=admin
SIMULATOR_PASSWORD=simulator123
